{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Themen-Tags",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "icon", "color"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string" },
      "name": { "type": "string" },
      "icon": { "type": "string" },
      "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
    }
  }
}
