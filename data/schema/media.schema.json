{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Medien",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string" },
      "name": { "type": "string" },
      "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
      "logo": { "type": "string" }
    }
  }
}
